[Unit]
Description=Run the {{ restic_native_job.job_name }} restic backup job as scheduled

[Timer]
OnCalendar={{ restic_native_job.job_schedule | default(restic_native_backup_schedule) }}
# A night missed because the host was off runs at the next boot, after the
# ZFS mounts the service orders itself behind
Persistent=true

[Install]
WantedBy=timers.target
