# Rendered by Ansible: the environment of the {{ restic_native_job.job_name }} restic job
# units and of the repository initialization run. systemd reads it, strips the
# single quotes, and expands nothing. The keys are in alphabetical order.
RESTIC_BACKUP_TAGS='{{ restic_native_job.job_name }}'
RESTIC_CACHE_DIR='/var/cache/{{ restic_native_cache_directory_name }}'
RESTIC_DIRECTORIES_TO_BACKUP='{{ restic_native_job.directories_to_backup | join(' ') }}'
RESTIC_FORGET_POLICY='{{ restic_native_job.restic_forget_policy | default(restic_native_forget_policy) | join(' ') }}'
RESTIC_PASSWORD='{{ restic_native_job.restic_repository_password }}'
RESTIC_REPOSITORY='{{ restic_native_job.restic_repository_host_path }}'
RESTIC_RESTORE_DRILL_INCLUDE='{{ restic_native_job.restic_restore_drill_include }}'
RESTIC_RESTORE_DRILL_TARGET='{{ restic_native_job.restic_restore_drill_host_path | default(restic_native_job.restic_repository_host_path | dirname ~ '/restore-drill-' ~ restic_native_job.job_name) }}'
RESTIC_TEXTFILE_COLLECTOR_DIRECTORY='{{ restic_native_textfile_collector_directory }}'
