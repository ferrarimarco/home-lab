[Unit]
Description=SenseHat metrics exporter
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre={{ build_python_venv_script_destination_path }} {{ sense_hat_exporter_virtual_env_path }} {{ sense_hat_exporter_requirements_file_path }}
# Remove the metrics file before starting and after any exit so that the node
# exporter textfile collector never serves stale data as current when the
# exporter is down or blocked.
ExecStartPre=rm -f "{{ sense_hat_exporter_prometheus_textfile_exporter_destination_file_path }}"
ExecStart={{ sense_hat_exporter_virtual_env_path }}/bin/python3 {{ sense_hat_exporter_executable_path }} --metrics_textfile_path {{ sense_hat_exporter_prometheus_textfile_exporter_destination_file_path }}
ExecStopPost=rm -f "{{ sense_hat_exporter_prometheus_textfile_exporter_destination_file_path }}"
StateDirectory={{ sense_hat_exporter_os_service_name }}
Restart=always
# Avoid a tight restart loop when the Sense HAT hardware reads fail
# persistently.
RestartSec=60

[Install]
WantedBy=multi-user.target
