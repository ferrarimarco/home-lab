[Unit]
Description=Check the WAN from the Asus router and restart it when no target answers

[Service]
# exec rather than oneshot so that RuntimeMaxSec bounds the run
Type=exec
Nice=-10
# The script runs on the router: it exits 0 when a target answers and 2 after
# a WAN restart, so a failed run is a failed unit.
ExecStart=sh -c 'ssh -p {{ asuswrt_administration_ssh_port }} {{ asuswrt_administrator_username }}@{{ edge_environment_gateway.fqdn }} "cat > {{ asuswrt_chkwan_script_destination_path_on_asus_router }} && chmod a+x {{ asuswrt_chkwan_script_destination_path_on_asus_router }} && {{ asuswrt_chkwan_script_destination_path_on_asus_router }}" < {{ asuswrt_chkwan_script_destination_path }}'
# Write nothing on the filesystem
ProtectSystem=strict
# Bound the run; the stop only ends the SSH session, and the script on the
# router holds no lock a stopped run could leave behind
RuntimeMaxSec=60
User={{ asuswrt_chkwan_user }}
Group={{ asuswrt_chkwan_user_group }}
