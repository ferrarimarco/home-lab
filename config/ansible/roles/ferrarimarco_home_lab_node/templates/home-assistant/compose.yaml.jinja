---
services:
  homeassistant:
    container_name: homeassistant
    image: "{{ container_images_ids["home-assistant"] }}"
    network_mode: host
    privileged: true
    restart: unless-stopped
    volumes:
      - {{ home_assistant_configuration_config_directory_path }}:/config
      - /etc/localtime:/etc/localtime:ro
      - /run/dbus:/run/dbus:ro
...
