[Unit]
Description=Run {{ restic_backup_job_name }} Restic backup job
Requires=docker.service

[Service]
# Fail the run when the repository path is backed by the root filesystem: with
# its mount gone, the path is a bare directory and the backup would land on
# the host's own disk (raspberrypi2, 2026-10-10). A failed unit reaches the
# SystemdUnitFailed alert; a skipped one would not.
ExecStartPre=/bin/sh -c 'test "$(findmnt --target {{ restic_backup_job_repository_host_path }} -no TARGET)" != /'
ExecStart= docker compose --file {{ restic_docker_compose_destination_file_path }} --profile "{{ restic_backup_default_backup_job_docker_compose_profile }}" run --build --env RESTIC_ENABLE_BACKUP="true" --env RESTIC_ENABLE_REPOSITORY_CHECK="true" --env RESTIC_REPOSITORY_CHECK_READ_DATA_CYCLE_DAYS="{{ restic_backup_job_check_read_data_cycle_days }}" --env RESTIC_ENABLE_PRUNE="true" --rm {{ restic_backup_job_name }}
